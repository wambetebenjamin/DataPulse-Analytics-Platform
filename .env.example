# ---------------------------------------------------------------------------
# DataPulse Analytics Platform — environment template
#
# Copy to .env.local for development, or paste into the Vercel project's
# Environment Variables panel for preview/production.
#
#   cp .env.example .env.local
#
# NOTHING in this file is a real credential. Never commit .env.local — it is
# already covered by .gitignore. Only NEXT_PUBLIC_* values reach the browser;
# every other key must stay server-side (Kenya DPA 2019, §Security safeguards).
#
# The app boots without any of these set: integrations degrade to a documented
# no-op, reCAPTCHA is skipped in development, and mail is logged to stdout.
# ---------------------------------------------------------------------------


# ===========================================================================
# Core
# ===========================================================================

# Canonical origin. Drives metadataBase, sitemap.xml, robots.txt, OG tags and
# the absolute links inside scheduled report emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ===========================================================================
# Authentication — NextAuth
# ===========================================================================

# Must match the deployed origin. Vercel sets this automatically on preview
# and production deployments; set it by hand for local development.
NEXTAUTH_URL=http://localhost:3000

# JWT/session signing key. Generate with:  openssl rand -base64 32
# Required in production — the build intentionally refuses a default there.
NEXTAUTH_SECRET=

# Shared password for the seeded demo team (see src/data/analytics.ts).
# Replace with a real identity provider or password store before launch.
DEMO_ACCOUNT_PASSWORD=datapulse2026


# ===========================================================================
# reCAPTCHA — v3 primary, v2 checkbox fallback below score 0.5
# ===========================================================================

# v3: protects registration, suspicious logins, contact, newsletter and the
# custom-project enquiry form.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# v2 "I'm not a robot" checkbox, served only when a v3 score < 0.5 comes back
# or after three failed sign-in attempts.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=


# ===========================================================================
# Email — Nodemailer SMTP, or SendGrid
# ===========================================================================
# Set SENDGRID_API_KEY to use the HTTP API, otherwise the SMTP block is used.
# With neither configured, messages are written to the server log instead.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

SENDGRID_API_KEY=

# From address on every outbound message, and the inbox that receives contact,
# custom-project and newsletter notifications.
MAIL_FROM="DataPulse Analytics <hello@datapulse.co.ke>"
MAIL_TEAM_INBOX=hello@datapulse.co.ke


# ===========================================================================
# Google Maps — customer clusters by Nairobi ward and county
# ===========================================================================
# Browser key. Restrict it by HTTP referrer in the Google Cloud console and
# enable only the Maps JavaScript API. Unset, the Customers tab falls back to
# a proportional-bubble plot plus an equivalent data table.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ===========================================================================
# WhatsApp Cloud API — report delivery and alert notifications
# ===========================================================================
# From Meta for Developers → WhatsApp → API Setup. The access token should be
# a permanent System User token, not the 24-hour test token.
# Unset, /api/report/deliver records the WhatsApp leg as skipped and still
# sends the email. The click-to-chat float button needs no credentials.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=


# ===========================================================================
# M-Pesa Daraja — Safaricom C2B transaction ingestion
# ===========================================================================

# "sandbox" (https://sandbox.safaricom.co.ke) or "production"
# (https://api.safaricom.co.ke).
MPESA_ENV=sandbox

# Paybill or Till number the business collects on.
MPESA_SHORT_CODE=

# App credentials from the Daraja portal, exchanged for an OAuth token.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Shared secret appended to the callback URL registered with Safaricom:
#   https://your-domain/api/integrations/mpesa?secret=THIS_VALUE
# The callback is unauthenticated by design, so this is what proves the
# request came from the registered endpoint. Generate with:
#   openssl rand -hex 32
MPESA_CALLBACK_SECRET=


# ===========================================================================
# Google Sheets — spreadsheet as a data source
# ===========================================================================
# Service account from Google Cloud IAM, with the Sheets API enabled. Share
# each source spreadsheet with the service account email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full PEM including the BEGIN/END lines. Keep the literal "\n"
# escapes if your host cannot store real newlines — the code normalises both.
GOOGLE_PRIVATE_KEY=


# ===========================================================================
# Vercel KV — durable rate limiting, idempotency keys, consent receipts
# ===========================================================================
# Created automatically when a KV store is linked to the Vercel project.
# Without them the limiter falls back to a per-instance in-memory counter,
# which is fine for a single region but not for production fan-out.
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ===========================================================================
# Vercel Blob — generated PDF reports and uploaded data files
# ===========================================================================
BLOB_READ_WRITE_TOKEN=


# ===========================================================================
# Billing — Stripe cards, M-Pesa for Kenyan subscribers
# ===========================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# ===========================================================================
# Image pipeline (build-time only, never needed at runtime)
# ===========================================================================
# Used by `node scripts/fetch-images.mjs` to download the East African
# photography listed in image-credits.md. Pexels or Unsplash, either works.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
